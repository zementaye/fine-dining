DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_MAPS_API_KEY=
# Cron endpoints are protected with this shared secret (Vercel Cron sends it as a header)
CRON_SECRET=

# Sentry error monitoring. Leave blank to run with Sentry effectively disabled
# (client/server/edge configs no-op without a DSN). SENTRY_AUTH_TOKEN is only
# needed for uploading source maps at build time (org/project + a CI/build-scoped
# auth token from Sentry) — omit it locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
